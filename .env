# The .env contains *Default Public* variables for the Astro project.
# If you would like to store secret variables, please use `.env.production` or `.env.development`.

# Static Site Configuration
SITE_TITLE="your Blog"
SITE_INDEX_TITLE="<em>your</em> Blog"
SITE_DESCRIPTION="A static Material Design blog powered by Typst and Astro."
SITE_OWNER="you"
SITE_SOURCE_URL="https://github.com/you/you.github.io"

# Deploys to GitHub Pages
# For a user site https://you.github.io the URL base is empty.
# For a project site https://username.github.io/repo, the URL base is /repo/.
SITE="https://you.github.io"
URL_BASE=""

# Giscus static comments (fill in your GitHub repo and discussion category)
GISCUS_REPO="you/you.github.io"
GISCUS_REPO_ID=""
GISCUS_CATEGORY="Announcements"
GISCUS_CATEGORY_ID=""
